# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# env files — never commit real secrets (only .env.example is tracked)
.env
.env.*
!.env.example

# credentials / secrets (Google OAuth client secrets, key files, certs)
client_secret*.json
*secret*.json
service-account*.json
credentials*.json
*.pem
*.key

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel (local project link — set env vars in the Vercel dashboard)
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# misc / junk
.DS_Store
Thumbs.db
null
.idea/
.vscode/
*.swp
