# Copy to .env and fill in real values. On Vercel, set these in
# Project → Settings → Environment Variables.

# Public site URL used for SEO metadata, Open Graph tags, sitemap & robots.
# Must be the full production URL, e.g. https://hero-kids-sigma.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

MONGODB_URI=
DBNAME=hero-kids

NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

EMAIL_USER=
EMAIL_PASS=
